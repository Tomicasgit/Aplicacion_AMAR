  <!-- Vista: Panel principal (Dashboard) -->
  <main id="appView" class="view app">
    <aside class="side">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <nav class="nav">
        <button class="active">▦ Inicio</button>
