<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e64e68">
  <title>A.M.A.R. — Alerta de Latidos y Monitoreo Autónomo</title>
  <style>
    :root {
      --red: #e64e68;
      --red2: #c93652;
      --ink: #222634;
      --muted: #72788a;
      --line: #e7e9ef;
      --bg: #f6f7fb;
      --card: #fff;
      --good: #169565;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, system-ui, -apple-system, sans-serif;
    }
    button, input {
      font: inherit;
    }
    button {
      cursor: pointer;
    }
    button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .view {
      display: none;
      min-height: 100vh;
    }
    .view.active {
      display: grid;
    }
    .auth {
      grid-template-columns: 44% 1fr;
    }
    .aside {
      padding: 46px clamp(28px, 6vw, 88px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #fff;
      background: linear-gradient(150deg, #9e183d, #e64e68 58%, #ff9b92);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 850;
    }
    .mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      background: #fff;
      color: var(--red);
      border-radius: 11px;
      font-size: 20px;
    }
    .aside h1 {
      margin: 0;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.08;
      letter-spacing: -2px;
    }
    .aside p {
      max-width: 360px;
      color: #ffe6e9;
      line-height: 1.65;
      margin-top: 16px;
    }
    .legal {
      color: #ffe1e6;
      font-size: 13px;
    }
    .auth-panel {
      display: grid;
      place-items: center;
      padding: 32px;
    }
    .form {
      width: min(100%, 410px);
    }
    .form h2 {
      margin: 0 0 8px;
      font-size: 31px;
      letter-spacing: -1px;
    }
    .lead {
      margin: 0 0 22px;
      color: var(--muted);
      line-height: 1.55;
    }
    .banner-info {
      background: #fff9e6;
      border: 1px solid #fed776;
      color: #8c6000;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 20px;
      line-height: 1.45;
    }
    .field {
      margin: 15px 0;
    }
    .field label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 750;
    }
    .field input {
      width: 100%;
      height: 51px;
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 0 14px;
      outline: 0;
      background: #fff;
      color: var(--ink);
    }
    .field input:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 4px #e64e681c;
    }
    .primary {
      width: 100%;
      height: 51px;
      margin-top: 10px;
      border: 0;
      border-radius: 11px;
      background: var(--red);
      color: #fff;
      font-weight: 800;
      transition: background 0.15s ease;
    }
    .primary:hover:not(:disabled) {
      background: var(--red2);
    }
    .switch-text {
      margin: 23px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }
    .switch-text a {
      color: var(--red);
      font-weight: 800;
      text-decoration: none;
    }
    .message {
      min-height: 22px;
      margin: 12px 0 0;
      text-align: center;
      color: var(--red);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
    }
    .message.success {
      color: var(--good);
    }

    /* Estilos del panel una vez iniciada la sesión */
    .app {
      grid-template-columns: 230px 1fr;
    }
    .side {
      min-height: 100vh;
      padding: 25px 15px;
      color: #fff;
      background: #25283a;
    }
    .side .brand {
      margin: 0 10px 36px;
    }
    .side .mark {
      color: #25283a;
    }
    .nav {
      display: grid;
      gap: 5px;
    }
    .nav button {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px;
      border: 0;
      border-radius: 9px;
      color: #c7c9d6;
      background: transparent;
      text-align: left;
    }
    .nav button.active, .nav button:hover {
      color: #fff;
      background: #ffffff18;
    }
    .logout {
      margin: 35px 10px 0;
      width: calc(100% - 20px);
      border: 0;
      border-radius: 9px;
      padding: 10px;
      color: #fff;
      background: #ffffff15;
      transition: background 0.15s ease;
    }
    .logout:hover {
      background: #ffffff2b;
    }
    .dashboard {
      width: min(100%, 1050px);
      padding: 42px;
      margin: auto;
    }
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 30px;
    }
    .top h1 {
      margin: 3px 0 0;
      font-size: 29px;
      letter-spacing: -1px;
    }
    .top small {
      color: var(--muted);
    }
    .badge {
      padding: 8px 11px;
      border-radius: 30px;
      background: #e1f8ed;
      color: var(--good);
      font-size: 12px;
      font-weight: 800;
    }
    .grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 17px;
    }
    .card {
      padding: 21px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--card);
      box-shadow: 0 5px 15px #22263408;
    }
    .card h3 {
      margin: 0 0 17px;
      font-size: 14px;
    }
    .pulse {
      grid-row: span 2;
      text-align: center;
    }
    .heart {
      font-size: 53px;
      color: var(--red);
      animation: beat 1.5s ease-in-out infinite alternate;
    }
    @keyframes beat {
      0% { transform: scale(1); }
      100% { transform: scale(1.1); }
    }
    .bpm {
      margin-top: 5px;
      font-size: 57px;
      font-weight: 850;
      letter-spacing: -3px;
    }
    .unit, .card small {
      color: var(--muted);
    }
    .state {
      margin-top: 10px;
      color: var(--good);
      font-size: 14px;
      font-weight: 700;
    }
    .metric b {
      display: block;
      margin-top: 8px;
      font-size: 21px;
    }
    .metric {
      min-height: 122px;
    }
    .wide {
      grid-column: span 2;
    }
        .record-list {
      display: grid;
      gap: 12px;
      margin-top: 14px;
    }

    .record-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--bg);
    }

    .record-info {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .record-info strong {
      display: block;
      margin-bottom: 5px;
    }

    .record-info small {
      color: var(--muted);
      line-height: 1.5;
    }

    .record-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .record-actions button {
      border: 0;
      border-radius: 8px;
      padding: 9px 12px;
      font-weight: 700;
    }

    .edit-button {
      background: #e8edff;
      color: #3049a5;
    }

    .delete-button {
      background: #ffe8ec;
      color: #a51e39;
    }

    .secondary {
      width: 100%;
      min-height: 44px;
      margin-top: 10px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: white;
      color: var(--ink);
      font-weight: 700;
    }
	.danger {
      border-color: #ffcbd2;
      background: #fff6f7;
    }
    .empty {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }
    .modal {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: none;
      place-items: center;
      padding: 20px;
      background: #1718268a;
    }
    .modal.show {
      display: grid;
    }
    .modal-card {
      width: min(100%, 430px);
      padding: 25px;
      border-radius: 16px;
      background: #fff;
    }
    .modal-card h2 {
      margin-top: 0;
    }
    .modal-card button + button {
      margin-top: 8px;
    }
    .secondary {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #fff;
    }
    .device-key {
      padding: 11px;
      border-radius: 8px;
      overflow-wrap: anywhere;
      background: #f5f6fa;
      font: 12px ui-monospace, monospace;
    }

    @media (max-width: 760px) {
      .auth {
        display: block !important;
      }
      .aside {
        display: none;
      }
      .auth-panel {
        min-height: 100vh;
        padding: 28px 22px;
      }
      .app {
        display: block !important;
      }
      .side {
        min-height: auto;
        padding: 15px;
        position: sticky;
        top: 0;
        z-index: 2;
      }
      .side .brand {
        margin: 0 0 12px;
      }
      .nav {
        display: flex;
        overflow: auto;
      }
      .nav button {
        white-space: nowrap;
      }
      .logout {
        display: none;
      }
      .dashboard {
        padding: 26px 18px;
      }
      .top {
        align-items: flex-start;
      }
      .grid {
        grid-template-columns: 1fr 1fr;
      }
      .pulse {
        grid-column: span 2;
        grid-row: auto;
      }
      .wide {
        grid-column: span 2;
      }
    }
    @media (max-width: 410px) {
      .grid {
        grid-template-columns: 1fr;
      }
      .pulse, .wide {
        grid-column: span 1;
      }
      .top h1 {
        font-size: 25px;
      }
      .badge {
        font-size: 10px;
      }
    }

/* Calendario de seguimiento cardíaco */
.heart-history-card {
  min-width: 0;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
}

.calendar-toolbar strong {
  text-align: center;
  text-transform: capitalize;
  font-size: 1.05rem;
}

.calendar-nav {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--bg);
  color: var(--text);
  font-size: 1.3rem;
  cursor: pointer;
}

.calendar-nav:hover {
  border-color: var(--good);
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin: 16px 0 12px;
  color: var(--muted);
  font-size: 0.8rem;
}

.calendar-legend span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.legend-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: transparent;
}

.legend-dot.has-readings {
  border-color: var(--good);
  background: var(--good);
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6px;
}

.calendar-weekday {
  padding: 8px 0;
  color: var(--muted);
  text-align: center;
  font-size: 0.75rem;
  font-weight: 600;
}

.calendar-day {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-width: 0;
  min-height: 48px;
  padding: 6px 2px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--bg);
  color: var(--text);
  cursor: pointer;
}

.calendar-day:disabled {
  border-color: transparent;
  background: transparent;
  cursor: default;
}

.calendar-day:not(:disabled):hover {
  border-color: var(--good);
}

.calendar-day.has-data {
  border-color: var(--good);
}

.calendar-day.selected {
  outline: 2px solid var(--good);
  outline-offset: 1px;
}

.calendar-day.today .day-number {
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.day-number {
  font-size: 0.9rem;
}

.day-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: transparent;
}

.calendar-day.has-data .day-indicator {
  background: var(--good);
}

.calendar-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 20px;
}

.calendar-stat {
  min-width: 0;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.calendar-stat small {
  display: block;
  color: var(--muted);
  font-size: 0.75rem;
}

.calendar-stat strong {
  display: block;
  margin-top: 5px;
  font-size: 1.15rem;
  overflow-wrap: anywhere;
}

.selected-day {
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

.selected-day h4 {
  margin: 0 0 12px;
}

@media (max-width: 520px) {
  .calendar-grid {
    gap: 4px;
  }

  .calendar-day {
    min-height: 42px;
    border-radius: 7px;
  }

  .calendar-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .calendar-legend {
    gap: 8px 12px;
  }
}

</style>
</head>
<body>

  <!-- Vista: Iniciar sesión -->
  <main id="loginView" class="view auth active">
    <aside class="aside">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <div>
        <h1>Tu seguridad, más cerca.</h1>
