<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e64e68">
  <title>A.M.A.R. — Alerta de Latidos y Monitoreo Autónomo</title>
  <style>
    :root {
      --red: #e64e68;
      --red2: #c93652;
      --ink: #222634;
      --muted: #72788a;
      --line: #e7e9ef;
      --bg: #f6f7fb;
      --card: #fff;
      --good: #169565;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, system-ui, -apple-system, sans-serif;
    }
    button, input {
      font: inherit;
    }
    button {
      cursor: pointer;
    }
    button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
    .view {
      display: none;
      min-height: 100vh;
    }
    .view.active {
      display: grid;
    }
    .auth {
      grid-template-columns: 44% 1fr;
    }
    .aside {
      padding: 46px clamp(28px, 6vw, 88px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: #fff;
      background: linear-gradient(150deg, #9e183d, #e64e68 58%, #ff9b92);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 850;
    }
    .mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      background: #fff;
      color: var(--red);
      border-radius: 11px;
      font-size: 20px;
    }
    .aside h1 {
      margin: 0;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.08;
      letter-spacing: -2px;
    }
    .aside p {
      max-width: 360px;
      color: #ffe6e9;
      line-height: 1.65;
      margin-top: 16px;
    }
    .legal {
      color: #ffe1e6;
      font-size: 13px;
    }
    .auth-panel {
      display: grid;
      place-items: center;
      padding: 32px;
    }
    .form {
      width: min(100%, 410px);
    }
    .form h2 {
      margin: 0 0 8px;
      font-size: 31px;
      letter-spacing: -1px;
    }
    .lead {
      margin: 0 0 22px;
      color: var(--muted);
      line-height: 1.55;
    }
    .banner-info {
      background: #fff9e6;
      border: 1px solid #fed776;
      color: #8c6000;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 20px;
      line-height: 1.45;
    }
    .field {
      margin: 15px 0;
    }
    .field label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 750;
    }
    .field input {
      width: 100%;
      height: 51px;
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 0 14px;
      outline: 0;
      background: #fff;
      color: var(--ink);
    }
    .field input:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 4px #e64e681c;
    }
    .primary {
      width: 100%;
      height: 51px;
      margin-top: 10px;
      border: 0;
      border-radius: 11px;
      background: var(--red);
      color: #fff;
      font-weight: 800;
      transition: background 0.15s ease;
    }
    .primary:hover:not(:disabled) {
      background: var(--red2);
    }
    .switch-text {
      margin: 23px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }
    .switch-text a {
      color: var(--red);
      font-weight: 800;
      text-decoration: none;
    }
    .message {
      min-height: 22px;
      margin: 12px 0 0;
      text-align: center;
      color: var(--red);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
    }
    .message.success {
      color: var(--good);
    }

    /* Estilos del panel una vez iniciada la sesión */
    .app {
      grid-template-columns: 230px 1fr;
    }
    .side {
      min-height: 100vh;
      padding: 25px 15px;
      color: #fff;
      background: #25283a;
    }
    .side .brand {
      margin: 0 10px 36px;
    }
    .side .mark {
      color: #25283a;
    }
    .nav {
      display: grid;
      gap: 5px;
    }
    .nav button {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px;
      border: 0;
      border-radius: 9px;
      color: #c7c9d6;
      background: transparent;
      text-align: left;
    }
    .nav button.active, .nav button:hover {
      color: #fff;
      background: #ffffff18;
    }
    .logout {
      margin: 35px 10px 0;
      width: calc(100% - 20px);
      border: 0;
      border-radius: 9px;
      padding: 10px;
      color: #fff;
      background: #ffffff15;
      transition: background 0.15s ease;
    }
    .logout:hover {
      background: #ffffff2b;
    }
    .dashboard {
      width: min(100%, 1050px);
      padding: 42px;
      margin: auto;
    }
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 30px;
    }
    .top h1 {
      margin: 3px 0 0;
      font-size: 29px;
      letter-spacing: -1px;
    }
    .top small {
      color: var(--muted);
    }
    .badge {
      padding: 8px 11px;
      border-radius: 30px;
      background: #e1f8ed;
      color: var(--good);
      font-size: 12px;
      font-weight: 800;
    }
    .grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 17px;
    }
    .card {
      padding: 21px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--card);
      box-shadow: 0 5px 15px #22263408;
    }
    .card h3 {
      margin: 0 0 17px;
      font-size: 14px;
    }
    .pulse {
      grid-row: span 2;
      text-align: center;
    }
    .heart {
      font-size: 53px;
      color: var(--red);
      animation: beat 1.5s ease-in-out infinite alternate;
    }
    @keyframes beat {
      0% { transform: scale(1); }
      100% { transform: scale(1.1); }
    }
    .bpm {
      margin-top: 5px;
      font-size: 57px;
      font-weight: 850;
      letter-spacing: -3px;
    }
    .unit, .card small {
      color: var(--muted);
    }
    .state {
      margin-top: 10px;
      color: var(--good);
      font-size: 14px;
      font-weight: 700;
    }
    .metric b {
      display: block;
      margin-top: 8px;
      font-size: 21px;
    }
    .metric {
      min-height: 122px;
    }
    .wide {
      grid-column: span 2;
    }
    .danger {
      border-color: #ffcbd2;
      background: #fff6f7;
    }
    .empty {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }
    .modal {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: none;
      place-items: center;
      padding: 20px;
      background: #1718268a;
    }
    .modal.show {
      display: grid;
    }
    .modal-card {
      width: min(100%, 430px);
      padding: 25px;
      border-radius: 16px;
      background: #fff;
    }
    .modal-card h2 {
      margin-top: 0;
    }
    .modal-card button + button {
      margin-top: 8px;
    }
    .secondary {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #fff;
    }
    .device-key {
      padding: 11px;
      border-radius: 8px;
      overflow-wrap: anywhere;
      background: #f5f6fa;
      font: 12px ui-monospace, monospace;
    }

    @media (max-width: 760px) {
      .auth {
        display: block !important;
      }
      .aside {
        display: none;
      }
      .auth-panel {
        min-height: 100vh;
        padding: 28px 22px;
      }
      .app {
        display: block !important;
      }
      .side {
        min-height: auto;
        padding: 15px;
        position: sticky;
        top: 0;
        z-index: 2;
      }
      .side .brand {
        margin: 0 0 12px;
      }
      .nav {
        display: flex;
        overflow: auto;
      }
      .nav button {
        white-space: nowrap;
      }
      .logout {
        display: none;
      }
      .dashboard {
        padding: 26px 18px;
      }
      .top {
        align-items: flex-start;
      }
      .grid {
        grid-template-columns: 1fr 1fr;
      }
      .pulse {
        grid-column: span 2;
        grid-row: auto;
      }
      .wide {
        grid-column: span 2;
      }
    }
    @media (max-width: 410px) {
      .grid {
        grid-template-columns: 1fr;
      }
      .pulse, .wide {
        grid-column: span 1;
      }
      .top h1 {
        font-size: 25px;
      }
      .badge {
        font-size: 10px;
      }
    }
  </style>
</head>
<body>

  <!-- Vista: Iniciar sesión -->
  <main id="loginView" class="view auth active">
    <aside class="aside">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <div>
        <h1>Tu seguridad, más cerca.</h1>
        <p>Alerta de Latidos y Monitoreo Autónomo. Consultá el estado de tu dispositivo y tus alertas en un solo lugar.</p>
      </div>
      <small class="legal">No diagnostica enfermedades ni reemplaza la atención médica.</small>
    </aside>
    <section class="auth-panel">
      <form id="loginForm" class="form">
        <div id="fileNoticeLogin" class="banner-info" style="display: none;">
          💡 <strong>Modo local:</strong> Abierto como archivo directo. Para sincronizar con el servidor PHP, ejecutá en terminal: <code>php -S localhost:8000</code>.
        </div>
        <h2>Iniciar sesión</h2>
        <p class="lead">Ingresá para consultar tu panel de monitoreo.</p>
        <div class="field">
          <label for="loginEmail">Correo electrónico</label>
          <input id="loginEmail" type="email" autocomplete="email" required placeholder="nombre@correo.com">
        </div>
        <div class="field">
          <label for="loginPassword">Contraseña</label>
          <input id="loginPassword" type="password" autocomplete="current-password" required placeholder="Tu contraseña">
        </div>
        <button id="loginBtn" class="primary" type="submit">Ingresar</button>
        <div class="message" id="loginMessage"></div>
        <p class="switch-text">¿No tenés cuenta? <a href="#" data-show="registerView">Crear cuenta</a></p>
      </form>
    </section>
  </main>

  <!-- Vista: Crear cuenta (Registro) -->
  <main id="registerView" class="view auth">
    <aside class="aside">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <div>
        <h1>Empezamos paso a paso.</h1>
        <p>Creá tu cuenta para preparar el monitoreo y los contactos de emergencia.</p>
      </div>
      <small class="legal">No diagnostica enfermedades ni reemplaza la atención médica.</small>
    </aside>
    <section class="auth-panel">
      <form id="registerForm" class="form">
        <div id="fileNoticeRegister" class="banner-info" style="display: none;">
          💡 <strong>Modo local:</strong> Abierto como archivo directo. Para sincronizar con el servidor PHP, ejecutá en terminal: <code>php -S localhost:8000</code>.
        </div>
        <h2>Crear cuenta</h2>
        <p class="lead">Tus datos se guardan de forma segura.</p>
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" required placeholder="Tu nombre">
        </div>
        <div class="field">
          <label for="registerEmail">Correo electrónico</label>
          <input id="registerEmail" type="email" required placeholder="nombre@correo.com">
        </div>
        <div class="field">
          <label for="registerPassword">Contraseña</label>
          <input id="registerPassword" type="password" minlength="6" required placeholder="Mínimo 6 caracteres">
        </div>
        <button id="registerBtn" class="primary" type="submit">Crear cuenta</button>
        <div class="message" id="registerMessage"></div>
        <p class="switch-text">¿Ya tenés cuenta? <a href="#" data-show="loginView">Iniciar sesión</a></p>
      </form>
    </section>
  </main>

  <!-- Vista: Panel principal (Dashboard) -->
  <main id="appView" class="view app">
    <aside class="side">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <nav class="nav">
        <button class="active">▦ Inicio</button>
        <button id="addDevice">⌁ Vincular ESP32</button>
        <button id="addContact">♧ Contactos</button>
      </nav>
      <button class="logout" id="logout">Cerrar sesión</button>
    </aside>
    <section class="dashboard">
      <header class="top">
        <div>
          <small>Panel del paciente</small>
          <h1>Hola, <span id="patientName">Paciente</span></h1>
        </div>
        <span id="deviceBadge" class="badge">Sin dispositivo</span>
      </header>
      <div class="grid">
        <article class="card pulse">
          <h3>Frecuencia cardíaca</h3>
          <div class="heart">♥</div>
          <div class="bpm" id="bpm">--</div>
          <div class="unit">latidos por minuto</div>
          <div id="heartState" class="state">Esperando lecturas del dispositivo</div>
        </article>
        <article class="card metric">
          <small>Última lectura</small>
          <b id="readingTime">Sin datos</b>
        </article>
        <article class="card metric">
          <small>Contactos de emergencia</small>
          <b id="contactsCount">0</b>
        </article>
        <article class="card wide">
          <h3>Ubicación más reciente</h3>
          <div class="empty" id="location">Todavía no se recibió una ubicación.</div>
        </article>
        <article class="card wide danger">
          <h3>Última alerta</h3>
          <div class="empty" id="alert">No hay alertas registradas.</div>
        </article>
      </div>
    </section>
  </main>

  <!-- Modal -->
  <div id="modal" class="modal">
    <div class="modal-card" id="modalContent"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase-config.js"></script>
  <script>
    const supabaseClient = window.supabase.createClient(
      window.AMAR_SUPABASE_URL,
      window.AMAR_SUPABASE_KEY
    );

    const $ = s => document.querySelector(s);

    function show(id) {
      document.querySelectorAll('.view').forEach(v => v.classList.toggle('active', v.id === id));
    }

    function message(id, text, isSuccess = false) {
      const el = $(id);
      el.textContent = text;
      el.className = isSuccess ? 'message success' : 'message';
    }

    function openModal(html) {
      $('#modalContent').innerHTML = html;
      $('#modal').classList.add('show');
    }

    function closeModal() {
      $('#modal').classList.remove('show');
    }

    // Navegación entre vistas de login y registro
    document.querySelectorAll('[data-show]').forEach(a => {
      a.onclick = e => {
        e.preventDefault();
        message('#loginMessage', '');
        message('#registerMessage', '');
        show(a.dataset.show);
      };
    });

    // Formulario de inicio de sesión con Supabase
    $('#loginForm').onsubmit = async e => {
      e.preventDefault();
      message('#loginMessage', '');

      const btn = $('#loginBtn');
      btn.disabled = true;
      btn.textContent = 'Ingresando...';

      try {
        const { data, error } = await supabaseClient.auth.signInWithPassword({
          email: $('#loginEmail').value.trim(),
          password: $('#loginPassword').value
        });

        if (error) throw error;

        message('#loginMessage', 'Ingreso correcto. Cargando panel...', true);
        await loadDashboard(data.user);
      } catch (err) {
        message('#loginMessage', err.message || 'No se pudo iniciar sesión.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Ingresar';
      }
    };

    // Formulario de registro con Supabase
    $('#registerForm').onsubmit = async e => {
      e.preventDefault();
      message('#registerMessage', '');

      const btn = $('#registerBtn');
      btn.disabled = true;
      btn.textContent = 'Creando cuenta...';

      const email = $('#registerEmail').value.trim();
      const name = $('#name').value.trim();
      const password = $('#registerPassword').value;

      try {
        const { data, error } = await supabaseClient.auth.signUp({
          email,
          password,
          options: {
            data: { name }
          }
        });

        if (error) throw error;

        $('#loginEmail').value = email;

        if (data.session && data.user) {
          message('#registerMessage', 'Cuenta creada correctamente. Cargando panel...', true);
          await loadDashboard(data.user);
        } else {
          message(
            '#registerMessage',
            'Cuenta creada. Iniciá sesión con tu correo y contraseña.',
            true
          );
          show('loginView');
          message('#loginMessage', 'Ya podés ingresar con tu cuenta.', true);
        }
      } catch (err) {
        message('#registerMessage', err.message || 'No se pudo crear la cuenta.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Crear cuenta';
      }
    };

    // Carga del panel desde las tablas de Supabase
    async function loadDashboard(user = null) {
      try {
        if (!user) {
          const { data, error } = await supabaseClient.auth.getUser();
          if (error) throw error;
          user = data.user;
        }

        if (!user) {
          show('loginView');
          return;
        }

        const results = await Promise.all([
          supabaseClient
            .from('profiles')
            .select('name')
            .eq('id', user.id)
            .maybeSingle(),

          supabaseClient
            .from('heart_readings')
            .select('lpm, recorded_at')
            .eq('user_id', user.id)
            .order('recorded_at', { ascending: false })
            .limit(1)
            .maybeSingle(),

          supabaseClient
            .from('devices')
            .select('name, status, last_seen_at')
            .eq('user_id', user.id)
            .order('created_at', { ascending: false })
            .limit(1)
            .maybeSingle(),

          supabaseClient
            .from('emergency_contacts')
            .select('id', { count: 'exact', head: true })
            .eq('user_id', user.id),

          supabaseClient
            .from('alerts')
            .select('type, message, created_at')
            .eq('user_id', user.id)
            .order('created_at', { ascending: false })
            .limit(1)
            .maybeSingle(),

          supabaseClient
            .from('locations')
            .select('latitude, longitude, recorded_at')
            .eq('user_id', user.id)
            .order('recorded_at', { ascending: false })
            .limit(1)
            .maybeSingle()
        ]);

        for (const result of results) {
          if (result.error) throw result.error;
        }

        const [profile, reading, device, contacts, alertData, locationData] =
          results.map(result => result.data);

        $('#patientName').textContent =
          profile?.name || user.user_metadata?.name || 'Paciente';

        $('#bpm').textContent = reading?.lpm ?? '--';
        $('#readingTime').textContent = reading?.recorded_at
          ? new Date(reading.recorded_at).toLocaleString()
          : 'Sin datos';

        $('#contactsCount').textContent = results[3].count ?? 0;

        $('#deviceBadge').textContent = device
          ? `${device.name}: ${device.status}`
          : 'Sin dispositivo';

        $('#heartState').textContent = reading
          ? 'Última lectura recibida'
          : 'Esperando lecturas del dispositivo';

        $('#location').textContent = locationData
          ? `${locationData.latitude}, ${locationData.longitude} — ${new Date(locationData.recorded_at).toLocaleString()}`
          : 'Todavía no se recibió una ubicación.';

        $('#alert').textContent = alertData
          ? `${alertData.type}: ${alertData.message || 'Sin descripción'}`
          : 'No hay alertas registradas.';

        show('appView');
      } catch (err) {
        console.error('Error al cargar el panel:', err);
        message(
          '#loginMessage',
          'No se pudo cargar el panel: ' + (err.message || 'Error desconocido.')
        );
        show('loginView');
      }
    }

    // Cerrar sesión en Supabase
    $('#logout').onclick = async () => {
      const { error } = await supabaseClient.auth.signOut();

      if (error) {
        message('#loginMessage', error.message);
        return;
      }

      message('#loginMessage', 'Sesión cerrada correctamente.', true);
      show('loginView');
    };

    // Modal para vincular ESP32
    $('#addDevice').onclick = () => openModal(`
      <h2>Vincular ESP32</h2>
      <p>Registrá el dispositivo en tu cuenta. La conexión con el ESP32 se integrará mediante Bluetooth desde el navegador.</p>
      <form id="deviceForm">
        <div class="field">
          <label>Nombre del dispositivo</label>
          <input id="deviceName" value="ESP32 A.M.A.R." required>
        </div>
        <button class="primary">Generar clave</button>
        <button type="button" class="secondary" onclick="closeModal()">Cancelar</button>
      </form>
    `);

    // Modal para agregar contacto
    $('#addContact').onclick = () => openModal(`
      <h2>Nuevo contacto</h2>
      <form id="contactForm">
        <div class="field">
          <label>Nombre</label>
          <input id="contactName" required>
        </div>
        <div class="field">
          <label>Teléfono</label>
          <input id="contactPhone" required>
        </div>
        <div class="field">
          <label>Relación</label>
          <input id="contactRelation" placeholder="Ej. Madre">
        </div>
        <button class="primary">Guardar contacto</button>
        <button type="button" class="secondary" onclick="closeModal()">Cancelar</button>
      </form>
    `);

    // Formularios de contactos y dispositivos mediante Supabase
    document.addEventListener('submit', async e => {
      if (e.target.id !== 'deviceForm' && e.target.id !== 'contactForm') {
        return;
      }

      e.preventDefault();

      const form = e.target;
      const submitButton = form.querySelector('button[type="submit"], button:not([type])');

      if (submitButton) {
        submitButton.disabled = true;
      }

      try {
        const { data: authData, error: authError } =
          await supabaseClient.auth.getUser();

        if (authError) throw authError;
        if (!authData.user) throw new Error('Tu sesión expiró. Iniciá sesión nuevamente.');

        const userId = authData.user.id;

        if (form.id === 'deviceForm') {
          const name = $('#deviceName').value.trim();

          if (!name) throw new Error('Ingresá un nombre para el dispositivo.');

          const { data, error } = await supabaseClient
            .from('devices')
            .insert({
              user_id: userId,
              name,
              status: 'offline'
            })
            .select('id, name, status')
            .single();

          if (error) throw error;

          openModal(`
            <h2>Dispositivo registrado</h2>
            <p><strong>${data.name.replace(/[&<>"']/g, c => ({
              '&': '&amp;', '<': '&lt;', '>': '&gt;',
              '"': '&quot;', "'": '&#39;'
            }[c]))}</strong> quedó asociado a tu cuenta.</p>
            <p>Estado inicial: sin conexión.</p>
            <p>La vinculación Bluetooth se implementará en el siguiente paso.</p>
            <button class="primary" onclick="closeModal();loadDashboard()">Entendido</button>
          `);
        }

        if (form.id === 'contactForm') {
          const name = $('#contactName').value.trim();
          const phone = $('#contactPhone').value.trim();
          const relationship = $('#contactRelation').value.trim();

          if (!name || !phone) {
            throw new Error('Completá el nombre y el teléfono del contacto.');
          }

          const { error } = await supabaseClient
            .from('emergency_contacts')
            .insert({
              user_id: userId,
              name,
              phone,
              relationship: relationship || null
            });

          if (error) throw error;

          closeModal();
          await loadDashboard();
        }
      } catch (err) {
        alert(err.message || 'No se pudo guardar la información.');
      } finally {
        if (submitButton && submitButton.isConnected) {
          submitButton.disabled = false;
        }
      }
    });

    // Restaurar la sesión guardada por Supabase al abrir la página
    (async () => {
      const { data, error } = await supabaseClient.auth.getSession();

      if (error) {
        console.error('Error al recuperar la sesión:', error);
        show('loginView');
        return;
      }

      if (data.session) {
        await loadDashboard(data.session.user);
      } else {
        show('loginView');
      }
    })();
  </script>
</body>
</html>
