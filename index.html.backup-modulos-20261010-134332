<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e64e68">
  <title>A.M.A.R. — Alerta de Latidos y Monitoreo Autónomo</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Vista: Iniciar sesión -->
  <main id="loginView" class="view auth active">
    <aside class="aside">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <div>
        <h1>Tu seguridad, más cerca.</h1>
        <p>Alerta de Latidos y Monitoreo Autónomo. Consultá el estado de tu dispositivo y tus alertas en un solo lugar.</p>
      </div>
      <small class="legal">No diagnostica enfermedades ni reemplaza la atención médica.</small>
    </aside>
    <section class="auth-panel">
      <form id="loginForm" class="form">
        <div id="fileNoticeLogin" class="banner-info" style="display: none;">
          💡 <strong>Modo local:</strong> Abierto como archivo directo. Para sincronizar con el servidor PHP, ejecutá en terminal: <code>php -S localhost:8000</code>.
        </div>
        <h2>Iniciar sesión</h2>
        <p class="lead">Ingresá para consultar tu panel de monitoreo.</p>
        <div class="field">
          <label for="loginEmail">Correo electrónico</label>
          <input id="loginEmail" type="email" autocomplete="email" required placeholder="nombre@correo.com">
        </div>
        <div class="field">
          <label for="loginPassword">Contraseña</label>
          <input id="loginPassword" type="password" autocomplete="current-password" required placeholder="Tu contraseña">
        </div>
        <button id="loginBtn" class="primary" type="submit">Ingresar</button>
        <div class="message" id="loginMessage"></div>
        <p class="switch-text">¿No tenés cuenta? <a href="#" data-show="registerView">Crear cuenta</a></p>
      </form>
    </section>
  </main>

  <!-- Vista: Crear cuenta (Registro) -->
  <main id="registerView" class="view auth">
    <aside class="aside">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <div>
        <h1>Empezamos paso a paso.</h1>
        <p>Creá tu cuenta para preparar el monitoreo y los contactos de emergencia.</p>
      </div>
      <small class="legal">No diagnostica enfermedades ni reemplaza la atención médica.</small>
    </aside>
    <section class="auth-panel">
      <form id="registerForm" class="form">
        <div id="fileNoticeRegister" class="banner-info" style="display: none;">
          💡 <strong>Modo local:</strong> Abierto como archivo directo. Para sincronizar con el servidor PHP, ejecutá en terminal: <code>php -S localhost:8000</code>.
        </div>
        <h2>Crear cuenta</h2>
        <p class="lead">Tus datos se guardan de forma segura.</p>
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" required placeholder="Tu nombre">
        </div>
        <div class="field">
          <label for="registerEmail">Correo electrónico</label>
          <input id="registerEmail" type="email" required placeholder="nombre@correo.com">
        </div>
        <div class="field">
          <label for="registerPassword">Contraseña</label>
          <input id="registerPassword" type="password" minlength="6" required placeholder="Mínimo 6 caracteres">
        </div>
        <button id="registerBtn" class="primary" type="submit">Crear cuenta</button>
        <div class="message" id="registerMessage"></div>
        <p class="switch-text">¿Ya tenés cuenta? <a href="#" data-show="loginView">Iniciar sesión</a></p>
      </form>
    </section>
  </main>

  <!-- Vista: Panel principal (Dashboard) -->
  <main id="appView" class="view app">
    <aside class="side">
      <div class="brand"><span class="mark">♥</span>A.M.A.R.</div>
      <nav class="nav">
        <button type="button" class="active" data-panel="homeSection">▦ Inicio</button>
        <button type="button" data-panel="historySection">▤ Historial</button>
        <button id="addDevice" type="button">⌁ Vincular ESP32</button>
        <button id="addContact" type="button">♧ Contactos</button>
      </nav>
      <div class="sidebar-account">
        <div class="sidebar-user-label">Sesión iniciada</div>
        <h2>Hola, <span id="patientName">Paciente</span></h2>
        <button type="button" class="sidebar-profile-edit" onclick="editProfile()">Editar perfil</button>
        <button class="logout" id="logout">Cerrar sesión</button>
      </div>
    </aside>
    <section class="dashboard">
      <header class="top">
        <span id="deviceBadge" class="badge">Sin dispositivo</span>
      </header>
      <div id="homeSection" class="dashboard-section active">
      <div class="grid">
        <article class="card pulse">
          <h3>Frecuencia cardíaca</h3>
          <div class="heart">♥</div>
          <div class="bpm" id="bpm">--</div>
          <div class="unit">latidos por minuto</div>
          <div id="heartState" class="state">Esperando lecturas del dispositivo</div>
        </article>
        <article class="card metric">
          <small>Última lectura</small>
          <b id="readingTime">Sin datos</b>
        </article>
        <article class="card wide daily-summary-card">
          <h3>Resumen de hoy</h3>
          <div id="dailySummary" class="calendar-summary">
            <p class="empty">Cargando resumen diario...</p>
          </div>
        </article>


        <article class="card metric">
          <small>Contactos de emergencia</small>
          <b id="contactsCount">0</b>
        </article>
                <article class="card wide">
          <h3>Mis dispositivos</h3>
          <div id="devicesList" class="record-list">
            <p class="empty">Cargando dispositivos...</p>
          </div>
        </article>

	 <article class="card wide">
          <h3>Mis contactos de emergencia</h3>
          <div id="contactsList" class="record-list">
            <p class="empty">Cargando contactos...</p>
          </div>
        </article>
	<article class="card wide">
          <h3>Ubicación más reciente</h3>
          <div class="empty" id="location">Todavía no se recibió una ubicación.</div>
        </article>
        <article class="card wide danger">
          <h3>Última alerta</h3>
          <div class="empty" id="alert">No hay alertas registradas.</div>
        </article>

      </div>
      </div>

        <div id="historySection" class="dashboard-section">
<article class="card wide heart-history-card">
  <h3>Seguimiento cardíaco</h3>
  <div class="calendar-toolbar">
    <button type="button" id="prevMonth" class="calendar-nav" aria-label="Mes anterior">&#8592;</button>
    <strong id="calendarMonth">Cargando mes...</strong>
    <button type="button" id="nextMonth" class="calendar-nav" aria-label="Mes siguiente">&#8594;</button>
  </div>
  <div class="calendar-legend">
    <span><i class="legend-dot has-readings"></i> Día con mediciones</span>
    <span><i class="legend-dot"></i> Sin mediciones</span>
  </div>
  <div id="calendarGrid" class="calendar-grid" aria-label="Calendario mensual"></div>
  <div id="calendarSummary" class="calendar-summary">
    <p class="empty">Cargando resumen mensual...</p>
  </div>
  <div class="selected-day">
    <h4 id="selectedDateTitle">Mediciones del día</h4>
    <div id="historyList" class="record-list">
      <p class="empty">Cargando historial...</p>
    </div>
  </div>
</article>
        </div>
    </section>
  </main>

  <!-- Modal -->
  <div id="modal" class="modal">
    <div class="modal-card" id="modalContent"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase-config.js"></script>
  <script src="app.js"></script>
</body>
</html>
